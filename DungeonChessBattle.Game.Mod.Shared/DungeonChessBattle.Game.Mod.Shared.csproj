<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <Description>展示契约层：条目数据读写口、装配上下文与表现契约，mod 与宿主互调。</Description>
  </PropertyGroup>

  <!-- 展示契约层：条目数据读写口与装配上下文由宿主实现、mod 调用，表现契约由 mod 实现、宿主调用。
       mod 入口契约在 Game.Mod.Interface，那个库引用本库取注册表类型，引用方向单向向下。
       与主工程同用 Godot.NET.Sdk：GodotSharp 由 SDK 隐式提供，版本天然对齐，中央包管理不再声明 GodotSharp。
       本库只以 Godot 类型作口成员，不定义 GodotObject 子类，故不产生脚本注册需求。 -->

  <ItemGroup>
    <ProjectReference Include="..\DungeonChessBattle.Game.Shared\DungeonChessBattle.Game.Shared.csproj" />
  </ItemGroup>

</Project>
