<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DungeonChessBattle.Lobby.Shared\DungeonChessBattle.Lobby.Shared.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Lobby.Protocol\DungeonChessBattle.Lobby.Protocol.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Client\DungeonChessBattle.Client.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Battle.GameConfig\DungeonChessBattle.Battle.GameConfig.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Game.Mod\DungeonChessBattle.Game.Mod.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Game.Shared\DungeonChessBattle.Game.Shared.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Battle.Client\DungeonChessBattle.Battle.Client.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Battle.Shared\DungeonChessBattle.Battle.Shared.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Battle.Entities\DungeonChessBattle.Battle.Entities.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Battle.Logic\DungeonChessBattle.Battle.Logic.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Replay\DungeonChessBattle.Replay.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Replay.Shared\DungeonChessBattle.Replay.Shared.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Replay.Protocol\DungeonChessBattle.Replay.Protocol.csproj" />
    <ProjectReference Include="..\DungeonChessBattle.Replay.Client\DungeonChessBattle.Replay.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
<!-- 游戏服务器以独立子进程方式运行，不再作为 Godot 工程的项目引用。
       Debug 构建前自动构建 Server 工程，保证子进程可执行文件存在且最新。 -->
  <Target Name="BuildGameServer" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Message Importance="high" Text="构建游戏服务器 (DungeonChessBattle.Server)..." />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\DungeonChessBattle.Server.Host\DungeonChessBattle.Server.Host.csproj&quot; -c Debug" />
  </Target>
</Project>
