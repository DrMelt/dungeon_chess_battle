<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <Description>mod 与宿主共用的展示形状：四类展示数据。</Description>
  </PropertyGroup>

  <!-- mod 与宿主共用的展示形状层：依赖 Battle.Shared 的强类型键——展示数据以内容身份为键，
       键必须与内容注册表里的身份同型，故这一份引用不可避免；
       带出的是零项目引用、不依赖 Godot 的单一程序集，代价到此为止。
       与主工程同用 Godot.NET.Sdk：GodotSharp 由 SDK 隐式提供，版本天然对齐。
       本库只以 Godot 类型作数据成员，不定义 GodotObject 子类，故不产生脚本注册需求。 -->

  <ItemGroup>
    <ProjectReference Include="..\DungeonChessBattle.Battle.Shared\DungeonChessBattle.Battle.Shared.csproj" />
  </ItemGroup>

</Project>
